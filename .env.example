# Comma-separated Google Drive folder IDs or folder URLs to index (subfolders included)
DRIVE_FOLDER_IDS=https://drive.google.com/drive/folders/XXXXXXXX,YYYYYYYY
# Shared password for the web UI (HTTP Basic auth, any username). Leave empty to disable.
DAM_PASSWORD=
# How often to re-scan Drive, in minutes
REFRESH_MINUTES=10
# Local dev only: path to a service account key. On Cloud Run, leave unset.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
