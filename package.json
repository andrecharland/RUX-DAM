{
  "name": "rux-dam",
  "version": "0.1.0",
  "private": true,
  "description": "Simple cloud DAM for RUX, backed by Google Drive folders of images and videos",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test 'test/*.test.js'",
    "test:e2e": "node --test --test-concurrency=1 'e2e/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "google-auth-library": "^10.1.0"
  }
}
